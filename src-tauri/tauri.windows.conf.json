{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "decorations": false,
        "titleBarStyle": "Visible",
        "hiddenTitle": false
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      }
    }
  }
}
